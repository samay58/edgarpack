# docs/learn/manifest.yml
#
# Generated by .learn-pack on {{DATE}}.
# Edit freely. Re-running the skill respects edits and updates files in place.

project: {{PROJECT_NAME}}
generated: {{DATE}}

# 8-12 line ascii diagram of the dominant lifecycle, plain English verbs.
# This goes into docs/learn/README.md as the napkin sketch.
napkin_sketch: |
  # TODO: draw the lifecycle here

# Trails: narrative walks through concrete actions.
# Order matters. trail-0 is the entry point a new reader hits first.
trails:
  - id: trail-0-<slug>
    title: "<title>"
    estimated_minutes: 18
    covers:
      - <module/file/function>
      - <module/file/function>
    why: "<one line: why this trail exists, what it teaches that nothing else does>"

# Refs: function-level reference docs.
# A module gets a ref if other modules depend on it heavily, or if it has
# subtle invariants worth surfacing. Glue and thin wrappers don't need refs.
refs:
  - id: ref-<module>
    module: <path/to/module>
    why: "<one line: why this module deserves its own ref>"

# Things you considered and deliberately skipped. Each gets one line of reason.
# Future runs will reconsider these — silent omissions are bugs.
omitted:
  - target: <module/feature>
    reason: "<one line>"
